{
  "workbench.iconTheme": "material-icon-theme",
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [80],
    "editor.selectionHighlight": false,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": false
  },
  "dart.openDevTools": "flutter",
  "dart.warnWhenEditingFilesOutsideWorkspace": false,
  "editor.fontSize": 19,
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "workbench.colorCustomizations": {
    "statusBar.background": "#0e0c0c",
    "Bar.background": "#0e0c0c",

    "menubar.selectionBackground": "#1a1818",
    "titleBar.activeBackground": "#0e0c0c",

    "editorGroupHeader.tabsBackground": "#0e0c0c",
    "editorGroupHeader.tabsBorder": "#0e0c0c",
    "tab.inactiveBackground": "#0e0c0c",
    "tab.hoverBackground": "#161616",
    "tab.border": "#1a1818",
    "tab.activeBackground": "#1a1818",
    "tab.activeBorder": "#fdc459e1",
    "tab.activeForeground": "#fdc459e1",

    "activityBar.foreground": "#fdc459e1",
    "activityBar.background": "#0e0c0c",
    "sideBarSectionHeader.background": "#0e0c0c",
    "sideBar.border": "#1f1e1e00",
    "sideBar.background": "#0e0c0c",
    "sideBarTitle.foreground": "#fdc459e1",
    "sideBarSectionHeader.foreground": "#fdc459e1",
    "list.activeSelectionForeground": "#fdc459e1",
    "editorGutter.background": "#0a0711",
    "editor.background": "#0a0711"
  },

  "[javascript]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "workbench.colorTheme": "Monokai Classic",
  "editor.renameOnType": true,

  "liveSassCompile.settings.formats": [
    {
      "format": "expanded",
      "extensionName": ".css",
      "savePath": "~/../css/"
    }
  ],
  "liveSassCompile.settings.includeItems": [
    "sass/main.scss",
    "xyz/foo/blaa/blaa/anything"
  ],

  "liveSassCompile.settings.generateMap": false,
  "liveServer.settings.donotShowInfoMsg": true,

  "liveServer.settings.donotVerifyTags": true,
  "compile-hero.jade-output-directory": "./css",
  "compile-hero.javascript-output-directory": "./js",
  "color-highlight.sass.includePaths": [],
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "terminal.integrated.shell.windows": "C:\\WINDOWS\\System32\\cmd.exe",
  "explorer.confirmDelete": false,
  "editor.formatOnType": true,
  "javascript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyParenthesis": false,
  "javascript.format.insertSpaceAfterOpeningAndBeforeClosingJsxExpressionBraces": false,
  "javascript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBrackets": false,
  "javascript.format.placeOpenBraceOnNewLineForControlBlocks": false,
  "javascript.format.placeOpenBraceOnNewLineForFunctions": false,
  "[javascriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "editor.tabSize": 2,
  "files.autoSave": "onFocusChange",
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.wordWrap": "on",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.arrowParens": "avoid",
  "prettier.singleQuote": true,
  "prettier.jsxSingleQuote": true,
  "editor.fontFamily": "Operator Mono lig",
  "editor.fontLigatures": true,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "name": "Comment",
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": {
          "fontStyle": "italic",
          "foreground": "#4A4A4A"
        }
      },

      {
        "name": "Keyword, Storage",
        "scope": ["Keyword", "Storage"],
        "settings": {
          "fontStyle": "italic"
        }
      },

      {
        "name": "Keyword Control",
        "scope": ["keyword.control"],
        "settings": {
          "fontStyle": "italic"
        }
      },

      {
        "scope": "entity.other.attribute-name",
        "settings": {
          //"foreground": "#78dce8"
        }
      },
      {
        "scope": "support.constant.property-value.css",
        "settings": {
          "foreground": "#ffb300cc"
        }
      },
      {
        "scope": "entity.other.attribute-name.pseudo-class.css",
        "settings": {
          "foreground": "#ffb300d8"
        }
      },

      {
        "name": "entity.name.method.js",
        "scope": ["entity.name.method.js"],
        "settings": {
          "fontStyle": "italic"
          //"foreground": "#82AAFF"
        }
      },
      {
        "name": "variable.language.this.js",
        "scope": ["variable.language.this.js"],
        "settings": {
          "fontStyle": "italic",
          "foreground": "#6d95ebe3"
        }
      },

      {
        "name": "Language methods",
        "scope": ["variable.language"],
        "settings": {
          "fontStyle": "italic"
          // "foreground": "#FF5370"
        }
      },

      {
        "name": "HTML Attributes",
        "scope": [
          "text.html.basic entity.other.attribute-name.html",
          "text.html.basic entity.other.attribute-name"
        ],
        "settings": {
          "fontStyle": "italic"
          //"foreground": "#FFCB6B"
        }
      },

      {
        "name": "Decorators",
        "scope": [
          "tag.decorator.js entity.name.tag.js",
          "tag.decorator.js punctuation.definition.tag.js"
        ],
        "settings": {
          "fontStyle": "italic"
          //"foreground": "#82AAFF"
        }
      },

      {
        "name": "ES7 Bind Operator",
        "scope": [
          "source.js constant.other.object.key.js string.unquoted.label.js"
        ],
        "settings": {
          "fontStyle": "italic"
          //"foreground": "#FF5370"
        }
      },

      {
        "name": "Markup - Italic",
        "scope": ["markup.italic"],
        "settings": {
          "fontStyle": "italic"
          //"foreground": "#f07178"
        }
      },

      {
        "name": "Markup - Bold-Italic",
        "scope": [
          "markup.bold markup.italic",
          "markup.italic markup.bold",
          "markup.quote markup.bold",
          "markup.bold markup.italic string",
          "markup.italic markup.bold string",
          "markup.quote markup.bold string"
        ],
        "settings": {
          "fontStyle": "bold"
          //"foreground": "#f07178"
        }
      },

      {
        "name": "Markup - Quote",
        "scope": ["markup.quote"],
        "settings": {
          "fontStyle": "italic"
          //"foreground": ""
        }
      },
      {
        "scope": "variable.other",
        "settings": {
          "foreground": "#60d5dbda"
        }
      },
      {
        "scope": "entity.name.function",
        "settings": {
          "foreground": "#fd6e6ee5"
        }
      },
      {
        "scope": "support.function",
        "settings": {
          "fontStyle": "italic",
          "foreground": "#66b2d4"
        }
      },
      {
        "scope": "string",
        "settings": {
          "foreground": "#85c77eef"
        }
      },
      {
        "scope": "constant.numeric.decimal.js",
        "settings": {
          //"foreground": "#ec6851"
        }
      },
      {
        "scope": "variable.other.object.js",
        "settings": {
          "foreground": "#fddc79d8"
        }
      }
    ]
  },
  "css.lint.vendorPrefix": "ignore",
  "json.maxItemsComputed": 50000000,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "explorer.incrementalNaming": "smart",
  "markdown.preview.fontSize": 16,
  "editor.accessibilityPageSize": 12,
  "explorer.confirmDragAndDrop": false,
  "security.workspace.trust.untrustedFiles": "open",
  "editor.lineHeight": 1.4,
  "tabnine.experimentalAutoImports": true,
  "python.terminal.executeInFileDir": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.suggest.preview": true,
  "editor.suggest.localityBonus": true,
  "editor.suggest.shareSuggestSelections": true,
  "editor.suggestSelection": "recentlyUsedByPrefix",
  "files.simpleDialog.enable": true,
  "mssql.connections": [
    {
      "server": "{{put-server-name-here}}",
      "database": "{{put-database-name-here}}",
      "user": "{{put-username-here}}",
      "password": ""
    }
  ],
  "gitlens.advanced.messages": {
    "suppressGitMissingWarning": true
  },
  "screencastMode.verticalOffset": 2,
  "bracketPairColorizer.depreciation-notice": false,
  "html.format.indentInnerHtml": true,
  "vscode-edge-devtools.mirrorEdits": true,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact"
  },
  "bracket-pair-colorizer-2.depreciation-notice": false,
  "editor.foldingMaximumRegions": 65000,
  "sass.format.deleteEmptyRows": false,
  "sass.format.deleteWhitespace": false,
  "rapidapi.terminalLink.enabled": true,
  "editor.cursorBlinking": "expand",
  "editor.cursorWidth": 5,
  "vscode-edge-devtools.webhint": false,
  "npm.keybindingsChangedWarningShown": true,
  "files.associations": {
    "*.js": "javascript",
    "*.jsx": "javascriptreact"
  },
  "prettier.jsxBracketSameLine": true,
  "react-native-tools.showUserTips": false,
  "workbench.editorAssociations": {
    "*.ldf": "default"
  },
  "editor.mouseWheelZoom": true,
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "typescript.updateImportsOnFileMove.enabled": "always",
  "[env]": {
    "editor.defaultFormatter": "IronGeek.vscode-env"
  },
  "window.zoomLevel": 1,
  "git.autofetch": true,
  "eslint.nodePath": " C:\\Program Files\\nodejs\\",
  "git.openRepositoryInParentFolders": "always",
  "editor.codeActionsOnSave": {},
  "workbench.settings.applyToAllProfiles": [
    
  ]
}
